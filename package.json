{
  "name": "ai-hub",
  "version": "1.2.0",
  "description": "Local-first AI harvesting hub for music-sharing sites. Harvests metadata after song plays; exposes a small REST API for the main LLM.",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "migrate": "node src/db/migrate.js",
    "keygen": "node bin/keygen.mjs",
    "python-ai": "python python_ai/server.py"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "bin": {
    "wd-artist": "./bin/wd-artist-overview.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.19.2",
    "morgan": "^1.10.0",
    "node-fetch": "^3.3.2",
    "ws": "^8.18.3",
    "zod": "^3.23.8"
  }
}
