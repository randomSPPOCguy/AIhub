# =====================================================
# AIhub Configuration Template
# =====================================================
#
# GETTING STARTED:
# 1. Copy this file to config.env: cp config.env.example config.env
# 2. Choose your inference engine below (ONNX-CUDA recommended for NVIDIA GPUs)
# 3. Customize paths and API keys as needed
# 4. Run: ./start.ps1 (Windows) or ./start.sh (Linux/Mac)
#
# =====================================================

# =====================================================
# INFERENCE ENGINE SETUP
# =====================================================
#
# AIhub will detect your hardware and recommend the best option:
#
# - ONNX + CUDA (Recommended for NVIDIA GPUs)
#   - Fast inference with NVIDIA GPU acceleration
#   - Requires: CUDA Toolkit installed
#   - Model: phi-3-mini-onnx-cuda
#
# - ONNX + CPU (For systems without NVIDIA GPU)
#   - Runs on CPU only (slower but compatible)
#   - No special requirements
#   - Model: phi-3-mini-onnx-cpu
#
# - PyTorch (Alternative for advanced users)
#   - Requires: PyTorch with CUDA support
#   - More memory intensive
#   - Model: varies
#
# - Cloud API (Fastest, requires paid API key)
#   - OpenAI, Anthropic, Google Gemini
#   - 1-3 second responses vs 11s local
#   - See PERFORMANCE_OPTIONS.md for details
#
# =====================================================

# =====================================================
# CUSTOMIZABLE CONFIGURATION (Edit these)
# =====================================================

# --- Model Paths ---
# Where to download and store AI models
# Windows example: C:\Users\Public\AIhub\Models (accessible to all users)
# Linux/Mac example: /usr/local/share/aihub/models or ~/.aihub/models
# Default: ./models/downloads (relative to project directory)
MODEL_DOWNLOAD_DIR=./models/downloads
PYTHON_MODEL_ROOT=./models/downloads

# --- Local Model Runtime ---
# Choose your inference engine based on hardware:
#
# For NVIDIA GPU (RECOMMENDED):
#   LOCAL_MODEL_NAME=phi-3-mini-onnx-cuda
#   LOCAL_MODEL_KIND=onnx-genai
#
# For CPU only:
#   LOCAL_MODEL_NAME=phi-3-mini-onnx-cpu
#   LOCAL_MODEL_KIND=onnx-genai
#
# For Ollama:
#   LOCAL_MODEL_NAME=phi3
#   LOCAL_MODEL_KIND=ollama
LOCAL_MODEL_NAME=phi-3-mini-onnx-cuda
LOCAL_MODEL_KIND=onnx-genai
LOCAL_MODEL_URL=http://localhost:8000
LOCAL_MODEL_API_KEY=
LOCAL_MODEL_CHAT_PATH=/v1/chat/completions
LOCAL_MODEL_ONNX_PATH=/api/chat

# --- Cloud API Keys (Optional - Leave blank to use local models only) ---
# Get API keys from:
#   OpenAI: https://platform.openai.com/api-keys
#   Anthropic: https://console.anthropic.com/settings/keys
#   Google: https://makersuite.google.com/app/apikey
#   Hugging Face: https://huggingface.co/settings/tokens
#   Discogs: https://www.discogs.com/settings/developers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
HUGGINGFACE_TOKEN=
DISCOGS_TOKEN=

# --- Service Ports & Host ---
# Main AIhub server port (HTTP API + WebSocket)
PORT=7071
HOST=0.0.0.0

# Python ONNX AI inference server port
PYTHON_AI_PORT=8000
PYTHON_AI_HOST=0.0.0.0

# Python enrichment service port (Wikipedia, MusicBrainz, Wikidata)
ENRICH_PORT=8001

# --- Database ---
# SQLite database for music facts, user profiles, conversation history
DB_PATH=./db/music.sqlite

# --- Bot Behavior ---
# Customize the AI assistant's personality and instructions
BOT_BEHAVIOR_PROMPT="You are the AI Hub room assistant. Use harvested metadata before calling external APIs."
# Or load from file:
# BOT_BEHAVIOR_PROMPT_FILE=./docs/prompt.txt

# =====================================================
# ADVANCED CONFIGURATION (Optional)
# =====================================================

# --- Core Networking ---
NODE_ENV=development
LOG_LEVEL=info
ALLOW_ORIGIN=*
AIHUB_BASE_URL=http://localhost:7071
AIHUB_WS_BASE_URL=
AIHUB_INTERNAL_BASE_URL=
PUBLIC_BASE_URL=
HUB_INTERNAL_BASE_URL=

# --- Python Service Config ---
PYTHON_AI_BASE=http://localhost:8000
PYTHON_AI_BIN=
PYTHON=python
AIHUB_PATH_APPEND=
CUDA_PATH_APPEND=

# --- Enrichment Service Config ---
ENRICH_URL=http://localhost:8001
ENRICH_TOKEN=
AIHUB_SERVICE_TOKEN=
ENRICH_TIMEOUT_MS=5000
ENRICHMENT_ENABLED=true
ENRICH_WIKIPEDIA_ENABLED=true
ENRICH_MUSICBRAINZ_ENABLED=true

# --- Harvest Tuning ---
# Cover Art Archive settings
HARVEST_CAA=true
CAA_MAX_SIZE=500
SUMMARY_CONCURRENCY=4
MAX_SONGS=20
MAX_ALBUMS=20

# --- User Agents ---
# Identify your bot to external APIs (customize contact email)
WIKI_UA=AIHubBot/1.0 (contact: you@example.com)
WIKIMEDIA_USER_AGENT=AIHubBot/1.0 (contact: you@example.com)
MB_UA_APP=AIHubBot
MB_UA_VERSION=1.1
MB_UA_CONTACT=you@example.com
MB_UA=
MB_SLEEP_MS=1000

# --- Cloud API Provider Defaults ---
# OpenAI
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
DEFAULT_OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-3-sonnet-20240229
DEFAULT_CLAUDE_MODEL=claude-3-sonnet-20240229

# Google Gemini
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GOOGLE_GEMINI_MODEL=gemini-1.5-pro
GEMINI_MODEL=gemini-1.5-pro
DEFAULT_GEMINI_MODEL=gemini-1.5-pro

# Hugging Face
HUGGINGFACE_BASE_URL=https://api-inference.huggingface.co
HUGGINGFACE_MODEL=mistralai/Mixtral-8x7B-Instruct-v0.1

# --- Security & Access Control ---
AIHUB_REQUIRE_KEY=true
BOT_KEYWORDS=bot,@bot,b0t

# --- MusicBrainz Release Filtering ---
MB_ALBUM_FILTER=
MB_RG_PRIMARY_INCLUDE=album
MB_RG_EXCLUDE_PRIMARY=single,ep
MB_RG_SECONDARY_EXCLUDE=live,compilation
MB_RG_STATUS_INCLUDE=

# =====================================================
# FIRST TIME SETUP CHECKLIST
# =====================================================
#
# [ ] Copied config.env.example to config.env
# [ ] Chose inference engine (ONNX-CUDA for NVIDIA GPU recommended)
# [ ] Set MODEL_DOWNLOAD_DIR to writable location
# [ ] (Optional) Added cloud API keys for faster responses
# [ ] Updated user agent contact email (WIKI_UA, MB_UA_CONTACT)
# [ ] Run: npm install
# [ ] Run: pip install -r python_ai/requirements.txt
# [ ] Run: pip install -r python_enrichment/requirements.txt
# [ ] Run: ./start.ps1 (Windows) or ./start.sh (Linux/Mac)
#
# For more help, see:
#   - README.md - Project overview and quick start
#   - PERFORMANCE_OPTIONS.md - Speed vs cost analysis
#   - ISSUES.md - Known issues and solutions
#   - docs/COMMON_ISSUES.md - Troubleshooting guide
#
# =====================================================
