# =====================================================
# Core service & networking
# =====================================================
PORT=7071
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
ALLOW_ORIGIN=*
DB_PATH=./db/music.sqlite

# Public URLs (override when running behind a tunnel/proxy)
AIHUB_BASE_URL=http://localhost:7071
AIHUB_WS_BASE_URL=
AIHUB_INTERNAL_BASE_URL=
PUBLIC_BASE_URL=
HUB_INTERNAL_BASE_URL=

# Optional download directory override
# Default: ./models/downloads (relative to project root - works on all platforms)
# Windows alternative: C:\Users\Public\AIhub\Models (accessible to all users)
# Linux/Mac alternative: /usr/local/share/aihub/models or ~/.aihub/models
MODEL_DOWNLOAD_DIR=./models/downloads

# =====================================================
# Authentication & behavior
# =====================================================
AIHUB_REQUIRE_KEY=true
BOT_KEYWORDS=bot,@bot,b0t
HUGGINGFACE_TOKEN=
BOT_BEHAVIOR_PROMPT="You are the AI Hub room assistant. Use harvested metadata before calling external APIs."
# BOT_BEHAVIOR_PROMPT_FILE=./docs/prompt.txt

# =====================================================
# Local runtimes & Python helper
# =====================================================
LOCAL_MODEL_NAME=phi-3-mini-onnx-cuda
LOCAL_MODEL_KIND=onnx-genai   # ollama | openai | onnx-genai
LOCAL_MODEL_URL=http://localhost:8000
LOCAL_MODEL_API_KEY=
LOCAL_MODEL_CHAT_PATH=/v1/chat/completions
LOCAL_MODEL_ONNX_PATH=/api/chat

PYTHON_AI_HOST=0.0.0.0
PYTHON_AI_PORT=8000
PYTHON_AI_BASE=http://localhost:8000
# Python model root (defaults to MODEL_DOWNLOAD_DIR if not set)
# Default: ./models/downloads (relative to project root - works on all platforms)
# Windows alternative: C:\Users\Public\AIhub\Models (accessible to all users)
# Linux/Mac alternative: /usr/local/share/aihub/models or ~/.aihub/models
PYTHON_MODEL_ROOT=./models/downloads
PYTHON_AI_BIN=
PYTHON=python
AIHUB_PATH_APPEND=
CUDA_PATH_APPEND=

# =====================================================
# Cloud provider credentials (blank => provider hidden)
# =====================================================
# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
DEFAULT_OPENAI_MODEL=gpt-4o-mini

# --- Anthropic / Claude ---
ANTHROPIC_API_KEY=
CLAUDE_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-3-sonnet-20240229
DEFAULT_CLAUDE_MODEL=claude-3-sonnet-20240229

# --- Google Gemini ---
GOOGLE_API_KEY=
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GOOGLE_GEMINI_MODEL=gemini-1.5-pro
GEMINI_MODEL=gemini-1.5-pro
DEFAULT_GEMINI_MODEL=gemini-1.5-pro

# --- Hugging Face Inference ---
HUGGINGFACE_API_KEY=
HUGGINGFACE_BASE_URL=https://api-inference.huggingface.co
HUGGINGFACE_MODEL=mistralai/Mixtral-8x7B-Instruct-v0.1

# =====================================================
# Metadata harvesting providers
# =====================================================
WIKI_UA=AIHubBot/1.0 (contact: you@example.com)
WIKIMEDIA_USER_AGENT=AIHubBot/1.0 (contact: you@example.com)
DISCOGS_TOKEN=

MB_UA_APP=AIHubBot
MB_UA_VERSION=1.1
MB_UA_CONTACT=you@example.com
MB_UA=
MB_SLEEP_MS=1000
MB_ALBUM_FILTER=
MB_RG_PRIMARY_INCLUDE=album
MB_RG_EXCLUDE_PRIMARY=single,ep
MB_RG_SECONDARY_EXCLUDE=live,compilation
MB_RG_STATUS_INCLUDE=

# =====================================================
# Harvest tuning & caches
# =====================================================
HARVEST_CAA=true
CAA_MAX_SIZE=500
SUMMARY_CONCURRENCY=4
MAX_SONGS=20
MAX_ALBUMS=20

# =====================================================
# Enrichment service (Project Frank)
# =====================================================
# Enrichment service URL (Python FastAPI service)
ENRICH_URL=http://localhost:8001
ENRICH_PORT=8001

# Optional authentication token for enrichment service
ENRICH_TOKEN=
AIHUB_SERVICE_TOKEN=

# Enrichment request timeout in milliseconds
ENRICH_TIMEOUT_MS=4000

# Feature flags for enrichment
ENRICHMENT_ENABLED=true
ENRICH_WIKIPEDIA_ENABLED=true
ENRICH_MUSICBRAINZ_ENABLED=true

